<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- 本机音频扫描：API 33+ 用细粒度音频权限；API <= 32 用旧存储权限 -->
    <uses-permission android:name="android.permission.READ_MEDIA_AUDIO" />
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />

    <!-- 后台播放前台服务：API 34 起 FGS 类型与类型专属权限必须成对声明 -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />

    <!-- 媒体会话通知对该权限豁免：被拒时播放仍继续，仅通知呈现受限。非阻塞请求。 -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- 纯单机：不声明 INTERNET / ACCESS_NETWORK_STATE。04 二期已按版权合规改为「导入本地文件」，不引入网络库。 -->
    <!-- 暂不声明 FOREGROUND_SERVICE_MEDIA_PROCESSING：本期导出在页面协程内完成，P2 接后台转码时再评估 FGS。 -->

    <application
        android:name=".ShiyinApp"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Shiyin">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:theme="@style/Theme.Shiyin">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
          exported=true 与官方 Media3 模板一致：允许系统/外部控制器（锁屏、蓝牙、
          Android Auto）绑定并连接 MediaSession。仅接受 MediaSessionService action。
        -->
        <service
            android:name=".playback.PlaybackService"
            android:exported="true"
            android:foregroundServiceType="mediaPlayback">
            <intent-filter>
                <action android:name="androidx.media3.session.MediaSessionService" />
            </intent-filter>
        </service>

        <!-- 不声明 BOOT_COMPLETED：API 35+ 禁止由此启动 mediaPlayback 前台服务，且一期不需要开机自启。 -->
        <!-- 不声明 MediaLibraryService / FileProvider：一期无车机浏览树与文件导出。 -->
    </application>

</manifest>
